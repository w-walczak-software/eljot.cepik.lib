<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:upki="http://uprawnieniakierowcow-przewoznicy.ul.api.cepik.coi.gov.pl"
             xmlns:ex="http://exceptions.api.cepik.coi.gov.pl"
             targetNamespace="http://uprawnieniakierowcow-przewoznicy.ul.api.cepik.coi.gov.pl">

    <xsd:annotation>
        <xsd:documentation>
            Uprawnienia Kierowców dla Przewoźników
            Version: 1.0.1
        </xsd:documentation>
    </xsd:annotation>

    <types>
        <schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://uprawnieniakierowcow-przewoznicy.ul.api.cepik.coi.gov.pl">
            <include schemaLocation="uprawnienia-kierowcow.przewoznicy.xsd"/>
        </schema>
        <schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://exceptions.api.cepik.coi.gov.pl">
            <include schemaLocation="exceptions/exceptions.xsd"/>
        </schema>
    </types>

    <message name="DaneDokumentuRequest">
        <part element="upki:DaneDokumentuRequest" name="daneDokumentuRequest"/>
    </message>

    <message name="DaneDokumentuResponse">
        <part element="upki:DaneDokumentuResponse" name="daneDokumentuResponse"/>
    </message>

    <message name="UprawnieniaKierowcowException">
        <part element="ex:cepikException" name="UprawnieniaKierowcowFault"/>
    </message>

    <portType name="UprawnieniaKierowcowPrzewoznicyApi">
        <operation name="pytanieOUprawnienia">
            <input message="upki:DaneDokumentuRequest"/>
            <output message="upki:DaneDokumentuResponse"/>
            <fault message="upki:UprawnieniaKierowcowException" name="UprawnieniaKierowcowException"/>
        </operation>
    </portType>

    <binding name="UprawnieniaKierowcowPrzewoznicySoapBinding" type="upki:UprawnieniaKierowcowPrzewoznicyApi">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="pytanieOUprawnienia">
            <soap:operation soapAction=""/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
            <fault name="UprawnieniaKierowcowException">
                <soap:fault name="UprawnieniaKierowcowException" use="literal"/>
            </fault>
        </operation>
    </binding>

    <service name="UprawnieniaKierowcowPrzewoznicyWebService">
        <port binding="upki:UprawnieniaKierowcowPrzewoznicySoapBinding" name="UprawnieniaKierowcowPrzewoznicySoapPort">
            <soap:address location=""/>
        </port>
    </service>

</definitions>
